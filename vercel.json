{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/trip/([^/]+)/?",
      "dest": "/trip.php?slug=$1"
    },
    {
      "src": "/admin/?",
      "dest": "/admin/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
